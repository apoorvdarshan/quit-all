{
  "name": "quit-all-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "quit-all.com: static pages built from TypeScript templates, plus a Cloudflare Worker for the app's API routes.",
  "scripts": {
    "build": "node src/site/build.ts",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy --keep-vars",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "check": "npm run lint -- --max-warnings=0 && npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "wrangler": "^4.151.0"
  }
}
