# Copy these names into GitHub → Settings → Secrets and variables → Actions → Variables.
# Missing or false = off. Values other than true/false/yes/no/on/off/1/0 fail the run,
# even when the master switch is off.

# --- iOS (v* tags; .github/workflows/ios-release.yml) ---
# Master switch: when off, no iOS store operation runs (a tag still creates the GitHub Release).
IOS_RELEASE_AUTOMATION=false
# Create the tag's App Store version in App Store Connect when it is missing (before
# the preflight). Leaves an existing version alone; refuses when another version is
# still on its way to the store or the tag is not newer than every existing version.
IOS_CREATE_VERSION=false
# Create every iOS product in store/catalog/products.json that App Store Connect does
# not have yet (matched by product ID) and bring it to Ready to Submit, before the
# build, so IOS_SUBMIT_REVIEW sends it to review in the same run. Existing products are
# never changed (differences are printed as warnings); one an interrupted run left in
# Missing Metadata is finished. Tag runs only; validation runs list the products
# read-only. RevenueCat offerings stay manual.
IOS_CREATE_PRODUCTS=false
# Build, sign and upload the binary to App Store Connect, then wait for processing.
# (Xcode Cloud's v* workflow was removed on 2026-10-14; never re-create it.)
IOS_UPLOAD_BUILD=false
# Description, keywords, promotional text, marketing/support URLs (store/metadata/ios/<locale>/).
IOS_UPLOAD_LISTING=false
# What's New text (store/metadata/ios/<locale>/whats_new.txt; whats_new_version.txt must equal the tag).
IOS_UPLOAD_WHATS_NEW=false
# iPhone 6.7"/6.9" and 6.5" screenshots listed in store/metadata/ios/<locale>/screenshots.json.
IOS_UPLOAD_SCREENSHOTS=false
# Product page header and search results images from store/creative/ios/header/ and
# store/creative/ios/search-results/ (no images yet, so keep it off). Each new image is
# uploaded to the Asset Library and sent to App Review on its own; once Apple approves
# it, a later run places it on every listing locale of the version.
IOS_UPLOAD_CREATIVE_ASSETS=false
# Select this run's processed build and submit the version (and Ready-to-Submit iOS
# products from store/catalog/products.json) for App Review. Needs IOS_UPLOAD_BUILD.
# The listing, What's New, screenshot, creative asset and review switches need the
# App Store version to exist: turn on IOS_CREATE_VERSION or create it in App Store
# Connect first. A read-only preflight checks it before anything is built.
IOS_SUBMIT_REVIEW=false
# true = release automatically after approval; false = you release it by hand.
# Needs IOS_SUBMIT_REVIEW.
IOS_PUBLIC_RELEASE=false
# Build readiness polling (defaults shown; 10–600 seconds and 10–300 minutes).
IOS_BUILD_POLL_SECONDS=30
IOS_BUILD_WAIT_MINUTES=120
